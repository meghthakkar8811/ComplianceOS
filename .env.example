# ============================================================
# ComplianceOS — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password_here
DB_NAME=complianceos

# ── APPLICATION ──────────────────────────────────────────────
# Change APP_URL to your domain in production
APP_URL=http://localhost:8000
APP_SECRET=change_this_to_a_random_64_char_string_in_production

# ── GOOGLE OAUTH ─────────────────────────────────────────────
# Get these from console.cloud.google.com
# 1. Create a project
# 2. Enable "Google+ API" and "People API"
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URI: http://localhost:8000/backend/auth/google_callback.php
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── EMAIL / SMTP ──────────────────────────────────────────────
# For Gmail: enable 2FA, then create an "App Password"
# For production: use SendGrid, Mailgun, or Amazon SES
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=noreply@complianceos.in
