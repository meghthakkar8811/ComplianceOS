ARG DEPS_BASE_IMAGE

# The shared dependency-jar layer (see Dockerfile.base / EnsureDepsBaseImageStage) — already
# has /deployments/lib/ and the quarkus user, so this only ever adds this one service's own,
# much smaller, non-shareable output: its own classes, generated bytecode, and launcher jar.
FROM ${DEPS_BASE_IMAGE}

ARG SERVICE_MODULE

COPY --chown=quarkus ${SERVICE_MODULE}/build/quarkus-app/*.jar /deployments/
COPY --chown=quarkus ${SERVICE_MODULE}/build/quarkus-app/app/ /deployments/app/
COPY --chown=quarkus ${SERVICE_MODULE}/build/quarkus-app/quarkus/ /deployments/quarkus/
# Quarkus fast-jar places agent-engine's own SNAPSHOT dependency jars, and this repo's own
# cross-module project dependencies (e.g. interfaces:rest and internal on compliance:api/
# compliance:core), into lib/main/ rather than app/ — app/ only ever holds SERVICE_MODULE's own
# compiled output. Because DEPS_BASE_IMAGE is keyed on the hash of gradle/libs.versions.toml, a
# republished agent-engine artifact, or a changed ComplianceOS module, under the same coordinates
# does not invalidate the base image; copying both groups here ensures the service container
# always runs the freshly-resolved jars without duplicating the 3rd-party libs the base image
# already carries.
COPY --chown=quarkus ${SERVICE_MODULE}/build/quarkus-app/lib/main/com.agentengine.*.jar /deployments/lib/main/
COPY --chown=quarkus ${SERVICE_MODULE}/build/quarkus-app/lib/main/com.complianceos.*.jar /deployments/lib/main/

ENTRYPOINT [ "sh", "-c", "java $JAVA_OPTS $JAVA_ARGS -jar /deployments/quarkus-run.jar" ]
